{
  "name": "folio-publisher",
  "productName": "Folio Publisher",
  "version": "2.0.0",
  "description": "An elegant desktop publishing studio for flyers, newsletters, cards and posters.",
  "author": "Folio Publisher",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "node scripts/build.mjs --dev && electron .",
    "test": "node --test tests/unit/",
    "serve": "node scripts/build.mjs && python3 -m http.server 8765 --directory app",
    "dist": "node scripts/build.mjs && electron-builder --win nsis --x64 --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.folio.publisher",
    "productName": "Folio Publisher",
    "copyright": "Folio Publisher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "!app/build/*.map",
      "desktop/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "folio",
        "name": "Folio Publication",
        "description": "Folio Publisher publication",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Folio-Publisher-Setup-${version}.${ext}",
      "legalTrademarks": "Folio Publisher"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio Publisher",
      "uninstallDisplayName": "Folio Publisher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5"
  }
}
