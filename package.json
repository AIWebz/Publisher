{
  "name": "folio-publisher",
  "productName": "Folio Publisher",
  "version": "2.2.1",
  "description": "An elegant desktop publishing studio for flyers, newsletters, cards and posters.",
  "author": "Folio Publisher",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "node scripts/build.mjs --dev && electron .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "serve": "node scripts/build.mjs && python3 -m http.server 8765 --directory app",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --x64 --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never",
    "pack": "node scripts/build.mjs && electron-builder --dir --publish never",
    "dicts": "node scripts/dictionaries.mjs",
    "build:icons": "python3 build/tools/make-icons.py",
    "test:desktop": "node tests/e2e/desktop-shell.mjs && node tests/e2e/desktop-package.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "three": "0.185.1"
  },
  "build": {
    "appId": "com.folio.publisher",
    "productName": "Folio Publisher",
    "copyright": "Copyright © 2026 Folio Publisher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "!app/build/**/*.map",
      "!**/*.{map,ts,md}",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "artifactName": "Folio-Publisher-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "extraResources": [
        {
          "from": "build/folio.icns",
          "to": "folio.icns"
        }
      ],
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2026 Folio Publisher",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folio Publication",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.folio.publisher.publication"
            ],
            "CFBundleTypeExtensions": [
              "folio"
            ],
            "CFBundleTypeIconFile": "folio.icns"
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.folio.publisher.publication",
            "UTTypeDescription": "Folio Publication",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeIconFile": "folio.icns",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "folio"
              ],
              "public.mime-type": [
                "application/vnd.folio.publication+json"
              ]
            }
          }
        ]
      }
    },
    "dmg": {
      "title": "Folio Publisher ${version}",
      "background": "build/background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Folio-Publisher-Setup-${version}.${ext}",
      "legalTrademarks": "Folio Publisher",
      "fileAssociations": [
        {
          "ext": "folio",
          "name": "Folio Publication",
          "description": "Folio Publisher publication",
          "icon": "build/folio.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio Publisher",
      "uninstallDisplayName": "Folio Publisher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "executableName": "folio-publisher"
    }
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "hunspell-asm": "4.0.2",
    "nspell": "^2.1.5"
  }
}
